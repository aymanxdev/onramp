{
  "$schema": "./tokens.schema.json",
  "$comment": "Designer export from the Onramp design system. Do not hand-edit tokens.css; run pnpm tokens:build. Two values per themed token: dark first (the default), then light.",
  "version": "2026.09.1",
  "color": {
    "bg-page": { "dark": "#141413", "light": "#faf9f5" },
    "bg-surface": { "dark": "#1c1c1a", "light": "#ffffff" },
    "bg-raised": { "dark": "#24241f", "light": "#ffffff" },
    "bg-subtle": { "dark": "#201f1c", "light": "#f2f0e6" },
    "border": { "dark": "#37372f", "light": "#e8e6dc" },
    "border-strong": { "dark": "#4a4941", "light": "#d3d0c3" },
    "text-primary": { "dark": "#faf9f5", "light": "#141413" },
    "text-secondary": { "dark": "#b0aea5", "light": "#5f5e57" },
    "text-muted": { "dark": "#918f86", "light": "#6b695f" },
    "accent-action": "#b5cd7a",
    "accent-action-edge": "#7e9c4f",
    "accent-action-ink": "#141413",
    "accent-action-soft": { "dark": "rgba(181,205,122,.14)", "light": "rgba(181,205,122,.3)" },
    "accent-action-text": { "dark": "#cfe39c", "light": "#556f2c" },
    "accent-attention": "#f2c94c",
    "accent-attention-edge": "#c9a43a",
    "accent-attention-ink": "#141413",
    "accent-attention-soft": { "dark": "rgba(242,201,76,.14)", "light": "rgba(242,201,76,.28)" },
    "accent-attention-text": { "dark": "#f2c94c", "light": "#6b4d00" },
    "accent-detail": "#d97757",
    "tint-chat": "#f2c94c",
    "tint-cowork": "#b5cd7a",
    "tint-code": "#6a9bcc",
    "tint-design": "#a878c9",
    "state-ok": { "dark": "#3fae9d", "light": "#1f7a6d" },
    "state-ok-soft": { "dark": "rgba(63,174,157,.16)", "light": "rgba(31,122,109,.14)" },
    "state-ok-text": { "dark": "#5cc7b6", "light": "#12564c" },
    "state-warn": { "dark": "#e8628f", "light": "#c2185b" },
    "state-warn-soft": { "dark": "rgba(232,98,143,.16)", "light": "rgba(194,24,91,.12)" },
    "dot": { "dark": "rgba(250,249,245,.075)", "light": "rgba(20,20,19,.1)" },
    "focus": { "dark": "#f2c94c", "light": "#7e5a00" },
    "ink": "#141413",
    "ivory": "#faf9f5"
  },
  "shadow": {
    "card": { "dark": "0 18px 44px rgba(0,0,0,.5)", "light": "0 14px 34px rgba(20,20,19,.1)" },
    "pop": { "dark": "0 10px 24px rgba(0,0,0,.4)", "light": "0 8px 20px rgba(20,20,19,.12)" },
    "edge-3": "0 3px 0",
    "edge-4": "0 4px 0"
  },
  "radius": { "sm": 8, "md": 16, "lg": 24, "xl": 28, "pill": 999 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 28, "8": 32, "12": 48 },
  "type": {
    "family-sans": "'IBM Plex Sans', system-ui, sans-serif",
    "family-mono": "'IBM Plex Mono', ui-monospace, monospace",
    "display": { "size": "clamp(34px, 5vw, 58px)", "line": 1.04, "tracking": "-0.03em", "weight": 700 },
    "hero": { "size": "clamp(32px, 4.6vw, 54px)", "line": 1.04, "tracking": "-0.03em", "weight": 700 },
    "h2": { "size": "clamp(26px, 3.4vw, 38px)", "line": 1.1, "tracking": "-0.02em", "weight": 700 },
    "h3": { "size": "19px", "line": 1.2, "tracking": "-0.015em", "weight": 700 },
    "body": { "size": "17px", "size-desktop": "18px", "line": 1.6, "measure": "66ch" },
    "mono-label": { "size": "10px", "line": 1, "tracking": "0.16em", "weight": 500 },
    "mono-eyebrow": { "size": "11px", "line": 1, "tracking": "0.18em", "weight": 500 }
  },
  "grid": { "dot-size": "1px", "dot-gap": "22px" },
  "motion": {
    "spring": {
      "boop": { "stiffness": 420, "damping": 14, "mass": 1 },
      "settle": { "stiffness": 260, "damping": 22, "mass": 1 },
      "sheet": { "stiffness": 320, "damping": 28, "mass": 1.1 }
    },
    "ease-spring": "cubic-bezier(.34,1.56,.64,1)",
    "duration": {
      "press": "160ms",
      "pop": "300ms",
      "drawer": "300ms",
      "copy-revert": "1200ms",
      "reduced": "120ms",
      "mascot-idle": "3.8s",
      "glow": "5s",
      "ring": "2.4s",
      "story": "6s",
      "heart": "3.4s",
      "ticker": "22s"
    }
  },
  "size": { "tap": 44, "control": 52, "seg": 38 }
}
