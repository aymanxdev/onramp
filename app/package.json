{
  "name": "onramp-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "postinstall": "node ../scripts/link-root-modules.mjs",
    "dev": "vite",
    "dev:api": "pnpm prompts:build && cd .. && WRANGLER_SEND_METRICS=false wrangler pages dev app/dist --compatibility-date=2026-09-01 --compatibility-flags=nodejs_compat --kv ONRAMP_KV --binding ENVIRONMENT=preview --binding LLM_PROVIDER=none --port 8788",
    "build": "pnpm tokens:build && pnpm data:build && pnpm prompts:build && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && node ../scripts/no-dashes.mjs src/content ../docs ../pipeline/catalogue.yaml",
    "typecheck": "tsc -b --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test --project=chromium --grep-invert \"@a11y|@visual\"",
    "test:visual": "playwright test --project=chromium --grep @visual",
    "test:a11y": "playwright test --project=chromium --grep @a11y",
    "size": "node ../scripts/bundle-size.mjs dist",
    "tokens:build": "node ../scripts/build-tokens.mjs",
    "prompts:build": "node ../scripts/build-prompts.mjs",
    "data:build": "python3 ../pipeline/build.py",
    "weekly:draft:build": "vite build --config ../scripts/weekly-update/vite.config.ts",
    "catalogue:validate": "python3 ../pipeline/validate.py --require officialUrl,asOf ../pipeline/catalogue.yaml"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/ibm-plex-sans": "^5.2.5",
    "@tanstack/react-router": "^1.130.0",
    "html-to-image": "^1.11.13",
    "minisearch": "^7.1.2",
    "motion": "^12.23.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-force-graph-2d": "^1.27.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/workers-types": "^4.20250801.0",
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.54.0",
    "@tanstack/router-plugin": "^1.130.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.16.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.26.0"
  }
}
