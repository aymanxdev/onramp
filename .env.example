# Public (safe in the browser)
VITE_TURNSTILE_SITE_KEY=            # Cloudflare Turnstile site key, public
VITE_SITE_URL=https://onramp.example # canonical URL for share links and OG
VITE_SHOW_USAGE=                    # set to "true" to show the public usage line, off by default
VITE_USAGE_MIN=100                  # routes counted before the usage line appears, default 100

# Config (plain vars, set in the Cloudflare Pages dashboard per environment, see functions/README.md; listed here for local reference only)
LLM_PROVIDER=workers-ai             # workers-ai | anthropic | none
LLM_MODEL=                          # model id, kept in config not code; Workers AI default when empty is @cf/meta/llama-3.1-8b-instruct-fp8
DAILY_LLM_BUDGET=300                # global circuit breaker, calls per day
RATE_LIMIT_PER_MINUTE=3
RATE_LIMIT_PER_DAY=1     # per IP per day, for LLM-backed (ambiguous) requests only; deterministic matches are unlimited

# Secrets (Cloudflare Pages secrets and GitHub Actions secrets only; never commit real values,
# set as encrypted Secrets in the Cloudflare Pages dashboard, see functions/README.md)
TURNSTILE_SECRET_KEY=               # server-side Turnstile verification
ANTHROPIC_API_KEY=                  # only when LLM_PROVIDER=anthropic
IP_HASH_SALT_SEED=                  # seed for the daily rotating salt
